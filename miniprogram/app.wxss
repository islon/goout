/* 全局样式 - 童行小程序 (Apple Style) */
page {
  --sand-primary: #0066CC;
  --sand-light: #4D9FE6;
  --sand-dark: #004C99;
  --sand-bg: #F5F5F7;
  --sand-50: #FFFFFF;
  --sand-100: #F5F5F7;
  --sand-200: #E8E8ED;
  --ocean: #0066CC;
  --ocean-light: #E3F0FF;
  --forest: #34C759;
  --forest-light: #E8F9ED;
  --bg-warm: #FFFFFF;
  --surface: #FFFFFF;
  --text-primary: #1D1D1F;
  --text-secondary: #6E6E73;
  --text-muted: #86868B;
  --border: #E8E8ED;
  --border-strong: #D2D2D7;
  --shadow-sm: 0 2rpx 4rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 24rpx 48rpx rgba(0, 0, 0, 0.08);
  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 32rpx;
  --radius-xl: 40rpx;

  background: var(--bg-warm);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  -webkit-font-smoothing: antialiased;
  letter-spacing: -0.2rpx;
}

/* 通用 badge 样式 */
.badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 600;
  white-space: nowrap;
}

.badge-free {
  background: #E8F9ED;
  color: #34C759;
}

.badge-paid {
  background: #FFF3E0;
  color: #FF9500;
}

.badge-type {
  background: #E3F0FF;
  color: #0066CC;
}

.badge-family {
  background: #FCE7F3;
  color: #AF52DE;
}

/* 筛选按钮 */
.filter-btn {
  display: inline-block;
  padding: 12rpx 28rpx;
  background: #F5F5F7;
  border: none;
  border-radius: 48rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  white-space: nowrap;
  flex-shrink: 0;
  font-weight: 500;
  line-height: 1.4;
}

.filter-btn.active {
  background: #0066CC;
  color: #FFFFFF;
  border-color: #0066CC;
  box-shadow: 0 4rpx 16rpx rgba(0, 102, 204, 0.25);
  font-weight: 600;
}

.filter-btn.disabled {
  opacity: 0.35;
}

/* 筛选区 */
.filter-section {
  background: var(--surface);
  padding: 20rpx 24rpx;
  border-bottom: 2rpx solid var(--border);
}

.filter-label {
  font-size: 20rpx;
  color: var(--text-muted);
  margin-bottom: 16rpx;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.filter-bar {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}
