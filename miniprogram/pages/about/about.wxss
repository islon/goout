/* 童行小程序 - 订阅日程页样式 */

.about-page {
  min-height: 100vh;
  background: #FFFFFF;
  padding-bottom: 60rpx;
}

/* 头部 */
.about-header {
  background: linear-gradient(135deg, #0066CC 0%, #004C99 100%);
  padding: 60rpx 40rpx 48rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.header-icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 12rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 16rpx;
}

.header-tag {
  display: inline-block;
  padding: 8rpx 24rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  border-radius: 24rpx;
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 500;
}

/* 通用 section */
.section {
  padding: 32rpx 24rpx 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1D1D1F;
  margin-bottom: 20rpx;
  border-left: 6rpx solid #0066CC;
  padding-left: 16rpx;
}

/* 提示文字 */
.subscribe-tip {
  font-size: 24rpx;
  color: #6E6E73;
  margin-bottom: 20rpx;
  line-height: 1.5;
}

/* 微信提醒卡片 */
.remind-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: linear-gradient(135deg, #E0F2F7 0%, #DCFCE7 100%);
  border-radius: 20rpx;
  padding: 28rpx;
  border: 2rpx solid #B9E4F0;
}

.remind-icon {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}

.remind-text {
  flex: 1;
}

.remind-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 6rpx;
}

.remind-desc {
  font-size: 24rpx;
  color: #57534E;
  line-height: 1.5;
}

/* 平台说明卡片 */
.platform-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #E8E8ED;
  box-shadow: 0 2rpx 8rpx rgba(0, 102, 204, 0.04);
}

.platform-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.platform-icon {
  width: 44rpx;
  height: 44rpx;
}

.platform-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D1D1F;
}

.platform-steps {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.step {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  font-size: 24rpx;
  color: #57534E;
  line-height: 1.6;
}

.step-num {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  background: linear-gradient(135deg, #0066CC 0%, #004C99 100%);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 50%;
}

.platform-note {
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  background: #FFF8F0;
  border: 1rpx solid #F5E4D0;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #92400E;
  line-height: 1.6;
}

/* 订阅链接列表 */
.subscribe-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 16rpx;
}

.subscribe-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 2rpx solid #E8E8ED;
  box-shadow: 0 2rpx 6rpx rgba(0, 102, 204, 0.04);
}

.subscribe-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.subscribe-city {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D1D1F;
}

.subscribe-count {
  font-size: 22rpx;
  color: #86868B;
}

.subscribe-action {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #0066CC;
  font-weight: 500;
}

.action-icon {
  width: 30rpx;
  height: 30rpx;
}

/* H5 链接卡片 */
.h5-card, .h5-schedule-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 2rpx solid #E8E8ED;
  margin-bottom: 12rpx;
}

.h5-icon {
  width: 52rpx;
  height: 52rpx;
  flex-shrink: 0;
}

.h5-content {
  flex: 1;
}

.h5-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 4rpx;
}

.h5-desc {
  font-size: 22rpx;
  color: #6E6E73;
  margin-bottom: 4rpx;
}

.h5-url {
  font-size: 22rpx;
  color: #86868B;
}

.h5-action {
  font-size: 24rpx;
  color: #0066CC;
  font-weight: 500;
  flex-shrink: 0;
}

/* 数据说明 */
.data-info {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx 28rpx;
  border: 2rpx solid #E8E8ED;
  margin-bottom: 20rpx;
}

.data-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  font-size: 24rpx;
  line-height: 1.8;
  padding: 10rpx 0;
  border-bottom: 2rpx solid #E8E8ED;
}

.data-row:last-child {
  border-bottom: none;
}

.data-label {
  color: #86868B;
  width: 120rpx;
  flex-shrink: 0;
}

.data-value {
  color: #57534E;
  flex: 1;
}

.feedback-row {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.feedback-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  border: 2rpx solid #E8E8ED;
}

.feedback-icon {
  width: 60rpx;
  height: 60rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.feedback-content {
  flex: 1;
}

.feedback-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #3D3229;
  margin-bottom: 8rpx;
}

.feedback-desc {
  font-size: 24rpx;
  color: #8C7E70;
}

/* 微信反馈按钮 */
.feedback-wx-btn {
  background: #07C160;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 16rpx;
  margin: 0 0 16rpx;
  padding: 0;
  line-height: 88rpx;
  height: 88rpx;
  border: none;
}

.feedback-wx-btn::after {
  border: none;
}

.feedback-action {
  font-size: 24rpx;
  color: #0066CC;
  font-weight: 500;
  flex-shrink: 0;
}

/* ========== 活动反馈区块 ========== */
.activity-feedback {
  margin-top: 20rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #DCFCE7 0%, #F0FDF4 100%);
  border-radius: 20rpx;
  border: 2rpx solid #BBF7D0;
  border-left: 8rpx solid #166534;
}

.activity-feedback-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #166534;
  margin-bottom: 8rpx;
}

.activity-feedback-desc {
  font-size: 24rpx;
  color: #6B7280;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.activity-feedback-input {
  width: 100%;
  min-height: 180rpx;
  padding: 20rpx;
  background: #FFFFFF;
  border: 2rpx solid #E5E7EB;
  border-radius: 14rpx;
  font-size: 28rpx;
  color: #3D3229;
  box-sizing: border-box;
  line-height: 1.6;
}

.activity-feedback-counter {
  font-size: 22rpx;
  color: #9CA3AF;
  text-align: right;
  margin-top: 6rpx;
}

.activity-feedback-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.activity-feedback-send {
  flex: 1;
  background: #166534;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 14rpx;
  padding: 0;
  line-height: 80rpx;
  height: 80rpx;
  border: none;
  margin: 0;
}

.activity-feedback-send[disabled] {
  background: #9CA3AF;
  color: #FFFFFF;
}

.activity-feedback-send::after {
  border: none;
}

.activity-feedback-cloud {
  background: #FFFFFF;
  color: #166534;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 14rpx;
  padding: 0 24rpx;
  line-height: 80rpx;
  height: 80rpx;
  border: 2rpx solid #166534;
  margin: 0;
}

.activity-feedback-cloud::after {
  border: none;
}

.activity-feedback-history {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #9CA3AF;
}

.history-arrow {
  font-size: 20rpx;
}

.feedback-history-panel {
  margin-top: 14rpx;
  padding: 16rpx;
  background: #FFFFFF;
  border-radius: 12rpx;
  border: 2rpx solid #E5E7EB;
  max-height: 400rpx;
  overflow-y: auto;
}

.feedback-history-item {
  padding: 14rpx 0;
  border-bottom: 2rpx solid #F1F5F9;
}

.feedback-history-item:last-child {
  border-bottom: none;
}

.feedback-history-time {
  font-size: 20rpx;
  color: #9CA3AF;
  margin-bottom: 4rpx;
}

.feedback-history-content {
  font-size: 24rpx;
  color: #57534E;
  line-height: 1.6;
  word-break: break-all;
}

.feedback-history-empty {
  font-size: 24rpx;
  color: #9CA3AF;
  text-align: center;
  padding: 24rpx 0;
}

/* 开源与共建 */
.open-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  border: 2rpx solid #E8E8ED;
  box-shadow: 0 2rpx 8rpx rgba(0, 102, 204, 0.04);
}

.open-desc {
  font-size: 24rpx;
  color: #57534E;
  line-height: 1.7;
  margin-bottom: 20rpx;
}

.open-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.open-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border: 2rpx solid #E8E8ED;
  border-radius: 14rpx;
  padding: 22rpx 24rpx;
}

.open-item-main {
  flex: 1;
}

.open-item-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 4rpx;
}

.open-item-desc {
  font-size: 22rpx;
  color: #86868B;
}

.open-item-action {
  font-size: 24rpx;
  color: #0066CC;
  font-weight: 500;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.open-note {
  margin-top: 18rpx;
  font-size: 22rpx;
  color: #B8B0A6;
  text-align: center;
}

/* 底部 */
.footer {
  text-align: center;
  padding: 56rpx 24rpx 0;
}

.footer-logo {
  width: 110rpx;
  height: 110rpx;
  margin-bottom: 14rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 102, 204, 0.15);
}

.footer-text {
  font-size: 26rpx;
  color: #0066CC;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.footer-sub {
  font-size: 22rpx;
  color: #86868B;
  margin-bottom: 28rpx;
}

/* 信息区：置于图标上方，精简展示 版本/更新/场馆 */
.footer-meta {
  text-align: center;
  margin-bottom: 28rpx;
}

.meta-line {
  display: block;
  font-size: 22rpx;
  color: #86868B;
  line-height: 1.9;
}

.meta-badge {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  margin-left: 8rpx;
  font-weight: 600;
}

.meta-badge.ok {
  background: #E7F6EC;
  color: #166534;
}

.meta-badge.pending {
  background: #FEF3C7;
  color: #B45309;
}

.meta-badge.partial {
  background: #F0EDE8;
  color: #6E6E73;
}
