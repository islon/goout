<!-- 童行小程序 - 场馆指南列表页 -->
<view class="page">

  <!-- 搜索框 -->
  <view class="search-bar">
    <view class="search-wrapper">
      <image class="search-icon" src="/assets/search-icon.png" mode="aspectFit" />
      <input class="search-input" type="text" placeholder="搜索场馆名称、地址或关键词..." value="{{searchQuery}}" bindinput="onSearchInput" confirm-type="search" />
      <image wx:if="{{searchQuery}}" class="search-clear-img" src="/assets/search-clear.png" mode="aspectFit" bindtap="onClearSearch" />
    </view>
  </view>

  <!-- 城市筛选 -->
  <view class="filter-section">
    <scroll-view scroll-x class="filter-scroll" enhanced show-scrollbar="{{false}}">
      <view class="filter-bar">
        <view wx:for="{{cities}}" wx:key="key"
          class="filter-btn {{cityFilter === item.key ? 'active' : ''}}"
          data-key="{{item.key}}" bindtap="onCityTap">
          {{item.name}}
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 区县筛选（仅在选定具体城市时显示） -->
  <view wx:if="{{cityFilter !== 'all'}}" class="filter-section">
    <scroll-view scroll-x class="filter-scroll" enhanced show-scrollbar="{{false}}">
      <view class="filter-bar">
        <view wx:for="{{districts}}" wx:key="*this"
          class="filter-btn {{(districtFilter === item || (districtFilter === 'all' && item === '全部区县')) ? 'active' : ''}}"
          data-key="{{item}}" bindtap="onDistrictTap">
          {{item}}
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 类型筛选（多行展示，可展开/收起） -->
  <view class="filter-section">
    <view class="filter-bar filter-bar-wrap {{typeExpanded ? '' : 'type-collapsed'}}">
      <view wx:for="{{types}}" wx:key="key"
        class="filter-btn {{typeFilter === item.key ? 'active' : ''}}"
        data-key="{{item.key}}" bindtap="onTypeTap">
        {{item.name}}
      </view>
    </view>
    <view wx:if="{{types.length > typeCollapseThreshold}}" class="expand-toggle" bindtap="onToggleType">
      {{typeExpanded ? '收起 ↑' : '展开更多 ▼'}}
    </view>
  </view>

  <!-- 统计信息 -->
  <view class="count-info">
    共 {{venues.length}} 个场馆{{cityFilter !== 'all' ? '· ' + (cityNameMap[cityFilter] || cityFilter) : ''}}
  </view>

  <!-- 场馆列表 -->
  <view class="venue-list" wx:if="{{venues.length > 0}}">
    <view wx:for="{{venues}}" wx:key="name" class="venue-card" bindtap="onVenueTap" data-name="{{item.name}}">
      <view class="venue-header">
        <view class="venue-name">{{item.name}}</view>
        <view class="venue-type">{{item.type}}</view>
      </view>
      <view wx:if="{{item.highlights && item.highlights.length > 0}}" class="venue-highlights">
        <view wx:for="{{item.highlights}}" wx:key="*this" wx:for-item="tag" class="highlight-tag">{{tag}}</view>
      </view>
      <view wx:if="{{item.address}}" class="venue-address">{{item.address}}</view>
      <view class="venue-footer">
        <view class="venue-fee">{{item.fee || '费用未知'}}</view>
        <view class="venue-count {{item.hasActivity ? 'has' : ''}}">
          {{item.hasActivity ? item.activityCount + ' 个活动' : '暂无活动'}}
        </view>
      </view>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="empty-state" wx:if="{{loading}}">
    <image class="empty-icon" src="/assets/about-museum.png" mode="aspectFit"></image>
    <view class="empty-text">场馆数据加载中...</view>
    <view class="empty-hint">首次加载可能需要几秒钟</view>
  </view>

  <!-- 空态 -->
  <view class="empty-state" wx:if="{{!loading && venues.length === 0}}">
    <image class="empty-icon" src="/assets/about-museum.png" mode="aspectFit"></image>
    <view class="empty-text">没有找到符合条件的场馆</view>
    <view class="empty-hint">换个城市或类型试试</view>
  </view>

</view>
