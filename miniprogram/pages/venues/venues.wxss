/* 童行小程序 - 场馆指南列表页样式 */

.page {
  min-height: 100vh;
  background: #FFFDF7;
  padding-bottom: 40rpx;
}

/* 搜索框 */
.search-bar {
  background: #FFFFFF;
  padding: 20rpx 24rpx;
  border-bottom: 2rpx solid #F5F0E8;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  flex: 1;
}

.search-icon {
  position: absolute;
  left: 20rpx;
  width: 36rpx;
  height: 36rpx;
  z-index: 1;
}

.search-input {
  width: 100%;
  padding: 20rpx 60rpx 20rpx 60rpx;
  border: 3rpx solid #E7DFD3;
  border-radius: 40rpx;
  font-size: 26rpx;
  background: #FFFFFF;
  color: #292524;
}

.search-clear-img {
  position: absolute;
  right: 16rpx;
  width: 28rpx;
  height: 28rpx;
  padding: 8rpx;
}

/* 筛选区 */
.filter-section {
  background: #FFFFFF;
  padding: 16rpx 24rpx;
  border-bottom: 2rpx solid #F5F0E8;
}

.filter-scroll {
  width: 100%;
  white-space: nowrap;
}

.filter-bar {
  display: inline-flex;
  gap: 12rpx;
  flex-wrap: nowrap;
}

.filter-scroll .filter-bar {
  flex-wrap: nowrap;
  display: inline-flex;
}

.filter-bar-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.type-collapsed {
  max-height: 72rpx;
  overflow: hidden;
}

.filter-btn {
  display: inline-block;
  padding: 10rpx 24rpx;
  background: #FFFFFF;
  border: 3rpx solid #E7DFD3;
  border-radius: 40rpx;
  font-size: 22rpx;
  color: #78716C;
  white-space: nowrap;
  flex-shrink: 0;
  font-weight: 500;
  line-height: 1.5;
}

.filter-btn.active {
  background: linear-gradient(135deg, #D4A373 0%, #B8895A 100%);
  color: #FFFFFF;
  border-color: #D4A373;
  box-shadow: 0 4rpx 12rpx rgba(212, 163, 115, 0.3);
  font-weight: 600;
}

.expand-toggle {
  text-align: center;
  font-size: 22rpx;
  color: #D4A373;
  padding: 12rpx 0 4rpx;
  font-weight: 500;
}

/* 统计信息 */
.count-info {
  text-align: center;
  font-size: 24rpx;
  color: #78716C;
  padding: 20rpx 0 12rpx;
}

/* 场馆列表 */
.venue-list {
  padding: 0 24rpx;
}

/* 场馆卡片 */
.venue-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(212, 163, 115, 0.06);
  border: 2rpx solid #F5F0E8;
  transition: all 0.2s;
}

.venue-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 20rpx rgba(212, 163, 115, 0.12);
}

.venue-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
  gap: 16rpx;
}

.venue-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #292524;
  flex: 1;
  line-height: 1.4;
}

.venue-type {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  background: #E0F2F7;
  color: #0891B2;
  font-size: 22rpx;
  border-radius: 16rpx;
  font-weight: 500;
}

.venue-highlights {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.highlight-tag {
  padding: 4rpx 14rpx;
  background: #FFF8F0;
  color: #C49A6C;
  font-size: 22rpx;
  border-radius: 10rpx;
}

.venue-address {
  font-size: 25rpx;
  color: #57534E;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.venue-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 2rpx solid #F5F0E8;
  padding-top: 16rpx;
}

.venue-fee {
  font-size: 24rpx;
  color: #78716C;
}

.venue-count {
  font-size: 24rpx;
  color: #A8A29E;
}

.venue-count.has {
  color: #D4A373;
  font-weight: 600;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #78716C;
}

.empty-hint {
  font-size: 24rpx;
  color: #A8A29E;
  margin-top: 12rpx;
}
